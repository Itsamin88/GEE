# Copy this file to `.env` and fill in whatever you have. Everything here is
# OPTIONAL: without any of it the crawler runs on public endpoints and records
# which advanced features were unavailable.
#
# NEVER commit the real .env file.

# --- Who is crawling -------------------------------------------------------
# Sent in the User-Agent so a site owner can reach you. Please set this.
DCR_CONTACT="Your Name <you@university.example>"

# --- Semantic extraction (optional) ----------------------------------------
# With a key, an LLM layer classifies ambiguous evidence. Every field it
# proposes must quote a passage that is then verified against the stored text;
# without a key the program runs deterministically and enlarges the review queue.
# ANTHROPIC_API_KEY=

# --- Academic databases (optional) -----------------------------------------
# CORE_API_KEY=
# BASE_API_KEY=

# --- Search engines (optional) ---------------------------------------------
# Any ONE of these widens discovery considerably. Without them the program uses
# the public HTML endpoints, which are rate-limited and sometimes refuse.
# BRAVE_API_KEY=
# SERPAPI_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
# BING_API_KEY=

# --- Registries (optional) -------------------------------------------------
# OPENCORPORATES_KEY=
